[[1,63,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>Position the vehicle on the ramp.</p><p>Proceed with the removal <a href=\"#/3025960\">7210E10</a> .</p><p>1. Undo the bolts (1a) and remove the vacuum air circuit resonator\n (1b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2001584.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[1,63,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Refit  the vacuum air circuit resonator\nand fix it using the bolts.</p><p>Proceed with the refitting <a href=\"#/3025960\">7210E10</a> .</p><p>Remove the car from the ramp.</p>"],[2,63,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>Position the vehicle on the ramp.</p><p>Proceed with the removal <a href=\"#/3025915\">7055B54</a> .</p><p>Proceed with the removal <a href=\"#/3025960\">7210E10</a> .</p><p>1. Undo bolts (1a) and remove the vacuum air circuit resonator (1b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2002019.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2,63,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Refit the vacuum air circuit resonator\nand secure with bolts.</p><p>Proceed with the refitting <a href=\"#/3025960\">7210E10</a> .</p><p>Proceed with the refitting <a href=\"#/3025915\">7055B54</a> .</p><p>Remove the car from the ramp.</p>"],[4,63,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Loosen the bands (1a) and remove the vacuum air circuit resonator\n(1b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2067870.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[4,63,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Place the vacuum air circuit resonator\nback in position and tighten the bands.</p>"]]