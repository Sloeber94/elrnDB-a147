A10</a></p><p><a href=\"#/3025386\">5010B45</a> (left and\nright sides)</p><p><a href=\"#/3025389\">5010B56</a></p><p><a href=\"#/3025805\">7040A95</a></p><p><a href=\"#/3025836\">7040L40</a> (left side)</p><p><a href=\"#/3025480\">5505A10</a></p><p><a href=\"#/3025431\">5040C10</a></p><p><a href=\"#/3025807\">7040A98</a></p>"],[31,63,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p><a href=\"#/3025807\">7040A98</a></p><p><a href=\"#/3025431\">5040C10</a></p><p><a href=\"#/3025480\">5505A10</a></p><p><a href=\"#/3025836\">7040L40</a> (left side)</p><p><a href=\"#/3025805\">7040A95</a></p><p><a href=\"#/3025389\">5010B56</a></p><p><a href=\"#/3025386\">5010B45</a> (left and\nright sides)</p><p><a href=\"#/3025796\">7040A10</a></p><p><a href=\"#/3025612\">5580C22</a></p><p><a href=\"#/3025795\">7040A09</a></p><p><a href=\"#/3025801\">7040A31</a></p><p><a href=\"#/3025798\">7040A14</a></p><p><a href=\"#/3025391\">5010C12</a></p><p><a href=\"#/3025403\">5010D56</a></p><p><a href=\"#/3025591\">5560B56</a></p><p><a href=\"#/3025590\">5560B11</a></p><p><a href=\"#/3025609\">5580C12</a></p><p><a href=\"#/3025799\">7040A26</a></p><p><a href=\"#/3025282\">4110A11</a></p><p><a href=\"#/3025611\">5580C18</a></p><p><a href=\"#/3025802\">7040A37</a></p><p><a href=\"#/3025613\">5580C26</a></p><p><a href=\"#/3025444\">5040D18</a></p><p>Fit the radio</p><p><a href=\"#/3025797\">7040A12</a></p><p><a href=\"#/3025833\">7040L20</a></p><p><a href=\"#/3025834\">7040L28</a></p><p><a href=\"#/3025869\">7045B18</a></p><p><a href=\"#/3025278\">3380A44</a></p><p><a href=\"#/3025803\">7040A65</a> (left\nand right sides)</p><p><a href=\"#/3025840\">7045A10</a> (left\nand right sides)</p><p>Repressurize the coolant <a href=\"#/3025410\">5040A10</a> .</p><p><a href=\"#/3024826\">1048A34</a></p><p><a href=\"#/3025915\">7055B54</a></p>"],[31,63,128,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>Remove the climate control system assembly\n <a href=\"#/3025431\">5040C10</a></p><p><a href=\"#/3025480\">5505A10</a></p><p>1. Remove the dashboard trim supporting crossmember.</p><p>2. Disconnect the wiring retainers.</p><p>3. Unscrew the bolts</p><p>4. Remove the air vent.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2005304.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[31,63,128,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Check that the crossmember is not damaged.</p><p>Position the air vent on the crossmember\nand secure it using the bolts.</p><p>Connect the dashboard wiring retainers\nto the crossmember.</p><p>Place the dashboard crossmember and wiring\nin position.</p><p><a href=\"#/3025480\">5505A10</a></p><p><a href=\"#/3025431\">5040C10</a></p>"]]