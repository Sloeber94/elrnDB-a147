[[16,63,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p><a href=\"#/3025751\">7025A12</a></p><p><a href=\"#/3025752\">7025A14</a></p>"],[16,63,0,"<p>1. Undo the bolts fixing the light cluster.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2005015.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[16,63,0,"<p>1. Move the light cluster slightly and disconnect the electrical\nconnection.</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>1</p></td><td><p>Left headlamp</p></td><td colspan=\"1\"><p><a href=\"#/3024055\">F10</a></p></td></tr></table></div><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>1</p></td><td><p>Right headlamp</p></td><td colspan=\"1\"><p><a href=\"#/3024060\">F11</a></p></td></tr></table></div><p>2. Recover the light cluster.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2005016.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[31,63,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Check that the light cluster\nis not damaged.</p><p>Connect the electrical connection.</p><p>Position the light cluster.</p><p>Tighten the bolts fixing the light cluster.</p>"],[16,63,0,"<p><a href=\"#/3025752\">7025A14</a></p><p><a href=\"#/3025751\">7025A12</a></p>"]]